{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Bobst.EP.JrmProxy": "Debug",
        "Default": "Information",
        "Npgsql": "Warning",
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "ResourcesBackgroundService": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./temp/JrmService.log",
          "shared": true,
          "rollOnFileSizeLimit": "true",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10000000
        }
      }
    ]
  },

  "HotFolder": {
    "SourceFolder": "C:\\HotFolder\\Incoming",
    "ArchiveFolder": "C:\\HotFolder\\Archive",
    "ErrorFolder": "C:\\HotFolder\\Error",

    "FileFilter": "*.*",
    "WatchSubdirectories": true,

    "ApplicationTypeFolders": {
      "qcs": "QCS",
      "dfe": "DFE",
      "jrm": "JRM"
    },

    "DeleteSourceAfterTransfer": true,
    "ArchiveEnabled": false,
    "ErrorFolderEnabled": true,

    "MaxRetries": 3,
    "RetryDelaySeconds": 5,

    "LockTimeoutSeconds": 30,
    "LockPollIntervalMs": 500,

    "RetentionHours": 168,
    "CleanupIntervalMinutes": 60,

    "Api": {
      "BaseUrl": "https://api.example.com",
      "UploadEndpoint": "/api/files/upload",
      "FormFieldName": "file",
      "TimeoutSeconds": 120,
      "MaxConcurrentUploads": 4,

      "ExtraFormFields": {
        "source": "hotfolder",
        "environment": "production"
      }
    }
  },

  "Receiver": {
    "Port": 85,
    "ReceiveEndpoint": "/filetransfer",
    "FormFieldName": "file",

    "ReceivedFolder": "C:\\HotFolder\\Received",
    "DecompressedFolder": "C:\\HotFolder\\Decompressed",
    "DecompressOnReceive": false,
    "KeepGzAfterDecompression": false,

    "MaxUploadBytes": 4294967296,

    "RecordRetentionHours": 168,
    "RecordCleanupIntervalMinutes": 60,

    "ApiKey": ""
  }
}
